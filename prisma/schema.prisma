generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  admin
  petugas
  pengasuh
}

enum Gender {
  L
  P
}

enum ClothingSize {
  S
  M
  L
  XL
  XXL
}

enum Mobility {
  mandiri
  tongkat
  kursi_roda
  bed_rest
}

enum ResidentStatus {
  aktif
  keluar
}

enum HistoryAction {
  tambah
  ubah
  berkas
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(petugas)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())

  documents Document[]
  histories HistoryEntry[]

  @@map("users")
}

model Resident {
  id              String         @id @default(cuid())
  fullName        String
  nickname        String?
  gender          Gender
  birthDate       DateTime       @db.Date
  clothingSize    ClothingSize?
  admissionDate   DateTime?      @db.Date
  admissionApprox Boolean        @default(false)
  referral        String?
  mobility        Mobility?
  healthNotes     String?
  status          ResidentStatus @default(aktif)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  documents Document[]
  histories HistoryEntry[]

  @@map("residents")
}

model Document {
  id           String   @id @default(cuid())
  fileName     String
  storagePath  String
  mimeType     String
  sizeBytes    Int
  createdAt    DateTime @default(now())
  residentId   String
  resident     Resident @relation(fields: [residentId], references: [id], onDelete: Cascade)
  uploadedById String
  uploadedBy   User     @relation(fields: [uploadedById], references: [id])

  @@index([residentId])
  @@map("documents")
}

model HistoryEntry {
  id           String        @id @default(cuid())
  action       HistoryAction
  summary      String
  residentName String // salinan nama, supaya riwayat tetap terbaca walau data penghuni dihapus
  createdAt    DateTime      @default(now())
  residentId   String?
  resident     Resident?     @relation(fields: [residentId], references: [id], onDelete: SetNull)
  actorId      String
  actor        User          @relation(fields: [actorId], references: [id])

  @@index([createdAt])
  @@map("history_entries")
}